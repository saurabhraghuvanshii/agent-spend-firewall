{
  "name": "@asf/proxy",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "@asf/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "audit:verify": "tsx --conditions=@asf/source src/cli/audit-verify.ts",
    "discover": "tsx --conditions=@asf/source src/cli/discover-tools.ts",
    "start": "tsx --conditions=@asf/source src/cli/proxy.ts",
    "dev": "tsx --conditions=@asf/source src/cli/proxy.ts",
    "mode": "tsx --conditions=@asf/source src/cli/proxy.ts mode"
  },
  "dependencies": {
    "@asf/approvals": "workspace:*",
    "@asf/core": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "better-sqlite3": "^12.11.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@asf/policies": "workspace:*",
    "@types/better-sqlite3": "^9.6.0",
    "tsx": "^4.23.15"
  }
}
