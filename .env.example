# Razorpay TEST mode only (must start with rzp_test_)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Dashboard API admin token (x-admin-token header). >= 32 chars, e.g. `openssl rand -hex 32`.
# Unset / short / placeholder ("change-me") => the API refuses every route except /health (fail closed).
# The AI AGENT MUST NEVER HOLD THIS TOKEN: keep it out of the agent's environment, this .env and the agent's
# working directory (the agent spawns the proxy, so prefer ASF_ADMIN_TOKEN_FILE below).
ASF_ADMIN_TOKEN=change-me
# Set in the proxy's LAUNCH environment only (ignored in .env, so not listed as keys here):
#   ASF_ADMIN_TOKEN_FILE  absolute path to a regular file (no symlink) holding the token, chmod 600, owned by the
#                         proxy's user, outside the repo / agent workdir. Wins over ASF_ADMIN_TOKEN; bad file => API off.
#   ASF_API_APPROVALS=1   approve / reject through the dashboard API (default off => 403; use Telegram).
# WARNING: the agent spawns the proxy and runs as the same OS user, so with shell/file tools it can read even a 0600
# token file. API approvals are only safe when the agent has no shell/file tools, or the proxy + token run as a
# separate OS user (or the token comes from a keychain). Recommended: leave ASF_API_APPROVALS off and use Telegram.
# Optional (T013): run the dashboard HTTP API inside the proxy on this port (1024-65535). Unset => no API.
ASF_API_PORT=
# Optional: bind address, loopback only (127.0.0.1 | localhost | ::1). Default 127.0.0.1.
ASF_API_HOST=
# Optional: comma-separated loopback origins allowed to call the API (default: the API itself + http://localhost:5173, http://127.0.0.1:5173).
ASF_API_ALLOWED_ORIGINS=
ASF_POLICY=policies/default.ts
# Dashboard (T014): API base URL, default http://127.0.0.1:8787. Vite reads it from the SHELL or
# packages/dashboard/.env.local (envDir is the dashboard package, never this root .env; only VITE_ASF_* reach the
# browser). The admin token is NOT configured here: you type it into the dashboard (kept in sessionStorage only).
VITE_ASF_API_URL=
ANTHROPIC_API_KEY=
# Optional: Razorpay MCP server Docker image used by `pnpm --filter @asf/proxy discover`
ASF_RAZORPAY_MCP_IMAGE=razorpay/mcp
